{
  "name": "strathex-switchyard",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Safe SXSY-B122 firmware transport and host routing baseline",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "build:vscode": "tsc -p apps/vscode-extension/tsconfig.build.json",
    "build:protocol": "tsc -p packages/protocol/tsconfig.build.json",
    "build:companion": "npm run build:protocol && tsc -p apps/windows-companion/tsconfig.build.json",
    "package:vscode:dry-run": "npm pack --dry-run --workspace @strathex/switchyard-vscode",
    "package:companion:dry-run": "npm run build:companion && npm pack --dry-run --workspace @strathex/switchyard-companion",
    "start:companion": "node --experimental-strip-types apps/windows-companion/src/main.ts",
    "test": "node --experimental-strip-types --test packages/protocol/test/*.test.ts packages/control-plane/test/*.test.ts apps/windows-companion/test/*.test.ts apps/vscode-extension/test/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0"
  }
}
