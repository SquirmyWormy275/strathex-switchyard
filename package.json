{
  "name": "strathex-switchyard",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "version": "0.1.0",
  "description": "Hardware-independent SXSY-B122 firmware, mediated Windows and Linux companions, VS Code control surface, and release tooling",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "workflow": "node scripts/workflow-capture.mjs",
    "build:vscode": "node scripts/clean-vscode-build.mjs && tsc -p apps/vscode-extension/tsconfig.build.json",
    "build:protocol": "tsc -p packages/protocol/tsconfig.build.json",
    "build:companion": "npm run build:protocol && tsc -p apps/windows-companion/tsconfig.build.json",
    "build:linux-companion": "npm run build:protocol && node scripts/clean-linux-build.mjs && tsc -p apps/linux-companion/tsconfig.build.json",
    "build:provider-host": "node scripts/clean-provider-build.mjs && tsc -p apps/provider-adapter-host/tsconfig.build.json",
    "start:companion": "node --experimental-transform-types apps/windows-companion/src/main.ts",
    "start:linux-companion": "node --experimental-transform-types apps/linux-companion/src/main.ts",
    "audit:omarchy-host": "node --experimental-transform-types apps/linux-companion/src/collect-omarchy-evidence.ts",
    "commission:omarchy-surfaces": "node --experimental-transform-types apps/linux-companion/src/commission-omarchy-surfaces.ts",
    "start:provider-host": "node --experimental-transform-types apps/provider-adapter-host/src/main.ts",
    "package:vscode:dry-run": "npm pack --dry-run --workspace @strathex/switchyard-vscode",
    "package:companion:dry-run": "npm run build:companion && npm pack --dry-run --workspace @strathex/switchyard-companion",
    "package:linux-companion:dry-run": "npm run build:linux-companion && npm pack --dry-run --workspace @strathex/switchyard-linux-companion",
    "package:provider-host:dry-run": "npm run build:provider-host && npm pack --dry-run --workspace @strathex/switchyard-provider-adapter-host",
    "test": "node scripts/run-platform-tests.mjs",
    "test:all": "node scripts/run-isolated-tests.mjs",
    "test:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-tests-windows.ps1",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0"
  }
}
