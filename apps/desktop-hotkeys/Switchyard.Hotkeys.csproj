<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- All helper modes use inherited pipes or native APIs, not a console.
         Avoid console initialization on the restricted private desktop while
         retaining ordinary Node spawn and its parent-loss Job containment. -->
    <OutputType>WinExe</OutputType>
    <StartupObject>Program</StartupObject>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../windows-companion/sandbox-helper/Program.cs" Link="SandboxGuestWorker.cs" />
    <Compile Include="../windows-companion/provider-desktop-helper/Program.cs" Link="NativeDesktopFocus.cs" />
    <Compile Include="../windows-companion/provider-desktop-helper/EditorEndpoint.cs" Link="NativeEditorEndpoint.cs" />
  </ItemGroup>
</Project>
