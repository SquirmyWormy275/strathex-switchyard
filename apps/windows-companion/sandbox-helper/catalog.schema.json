{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sxsy.invalid/schemas/b122-windows-sandbox-catalog-v1.json",
  "title": "SXSY-B122 Windows Sandbox fixed recipe catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "recipes"],
  "properties": {
    "schema": { "const": "sxsy-b122.windows-sandbox-catalog" },
    "version": { "const": 1 },
    "recipes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "executable", "executableSha256", "arguments", "workingRoot", "workingDirectory", "environment", "timeoutMs", "maxOutputBytes", "artifacts"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
          "executable": { "type": "string", "minLength": 1, "maxLength": 2048 },
          "executableSha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
          "arguments": { "type": "array", "maxItems": 128, "items": { "type": "string", "minLength": 1, "maxLength": 4096 } },
          "workingRoot": { "enum": ["input", "work"] },
          "workingDirectory": { "type": "string", "minLength": 1, "maxLength": 1024 },
          "environment": { "type": "object", "maxProperties": 64, "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 8192 } },
          "timeoutMs": { "type": "integer", "minimum": 50, "maximum": 86400000 },
          "maxOutputBytes": { "type": "integer", "minimum": 1, "maximum": 1048576 },
          "artifacts": { "type": "array", "maxItems": 128, "items": { "type": "string", "minLength": 1, "maxLength": 1024 } }
        }
      }
    }
  }
}
