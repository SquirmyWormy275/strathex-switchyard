[Unit]
Description=SXSY-B122 configured provider adapter host
Documentation=https://github.com/SquirmyWormy275/strathex-switchyard
After=sxsy-b122.service
Requires=sxsy-b122.service

[Service]
Type=simple
ExecStart=%h/.local/share/strathex-switchyard/current/runtime/bin/node %h/.local/share/strathex-switchyard/current/deployment/provider-host-launch.mjs
WorkingDirectory=%h/.local/share/strathex-switchyard/current
Restart=on-failure
RestartSec=2s
KillMode=control-group
TimeoutStopSec=20s
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
Environment=NODE_ENV=production

[Install]
WantedBy=default.target
